<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:icon="@drawable/asterion_icon_oficial"
        android:roundIcon="@drawable/asterion_icon_oficial"
        android:theme="@style/Theme.AsterionSystem">
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AsterionSplash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ProfileGateActivity"
            android:exported="false"
            android:theme="@style/Theme.AsterionSplash" />
        <activity
            android:name=".ProfileCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.AsterionSystem" />
        <activity android:name=".ProfileDetailsActivity" android:exported="false" />
        <activity android:name=".CalendarActivity" android:exported="false" />
        <activity android:name=".RoutinesActivity" android:exported="false" />
        <activity android:name=".NativeAvatarActivity" android:exported="false" />
        <activity
            android:name=".RoutineStepActivity"
            android:exported="false" />
        <activity
            android:name=".MissionsActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
    </application>
</manifest>
