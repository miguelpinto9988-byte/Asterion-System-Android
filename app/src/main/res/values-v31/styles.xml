<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash stays blank and dark until native approved artwork draws. -->
    <style name="Theme.AsterionSplash" parent="Theme.AsterionSystem">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/asterion_background</item>
        <item name="android:windowSplashScreenBackground">@color/asterion_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/asterion_splash_blank_icon</item>
    </style>
</resources>
