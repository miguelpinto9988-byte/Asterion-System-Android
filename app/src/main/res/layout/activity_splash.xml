<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/asterionPage">
    <!-- Full-bleed cover: intentionally crop small outer edges on different aspect ratios. -->
    <ImageView
        android:id="@+id/splash_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/asterionPage"
        android:scaleType="centerCrop"
        android:contentDescription="@string/splash_day_description"
        android:importantForAccessibility="yes" />
</FrameLayout>
