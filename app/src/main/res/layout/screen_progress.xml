<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/asterion_night_backdrop"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/progress_title"
        android:textColor="@color/asterion_text"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="serif" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/progress_description"
        android:textColor="@color/asterion_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/progress_prev_day"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:contentDescription="@string/progress_previous_day"
            android:text="‹" />

        <TextView
            android:id="@+id/progress_day_label"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/asterion_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/progress_next_day"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:contentDescription="@string/progress_next_day_label"
            android:text="›" />
    </LinearLayout>

    <TextView
        android:id="@+id/progress_status"
            android:accessibilityLiveRegion="polite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/progress_loading"
        android:textColor="@color/asterion_text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/progress_retry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_retry_read" />

    <ListView
        android:id="@+id/progress_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/progress_show_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/progress_open_summary" />

    <Button
        android:id="@+id/progress_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/navigation_back_to_home" />
</LinearLayout>
