<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/asterion_night_backdrop"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/asterion_crest" />

        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/plan_title"
        android:textColor="@color/asterion_text"
        android:textSize="24sp"
            android:letterSpacing="0.04"
        android:textStyle="bold"
        android:fontFamily="serif" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/plan_subtitle"
        android:textColor="@color/asterion_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/plan_previous_week"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/plan_previous_week"
            android:text="‹"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/plan_week_title"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/asterion_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/plan_next_week"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/plan_next_week"
            android:text="›"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/plan_day_0" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" android:background="@drawable/asterion_day_selector"
            android:textStyle="bold" />
        <Button android:id="@+id/plan_day_1" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" android:background="@drawable/asterion_day_selector"
            android:textStyle="bold" />
        <Button android:id="@+id/plan_day_2" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" android:background="@drawable/asterion_day_selector"
            android:textStyle="bold" />
        <Button android:id="@+id/plan_day_3" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" android:background="@drawable/asterion_day_selector"
            android:textStyle="bold" />
        <Button android:id="@+id/plan_day_4" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" android:background="@drawable/asterion_day_selector"
            android:textStyle="bold" />
        <Button android:id="@+id/plan_day_5" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" android:background="@drawable/asterion_day_selector"
            android:textStyle="bold" />
        <Button android:id="@+id/plan_day_6" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" android:background="@drawable/asterion_day_selector"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/plan_selected_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/asterion_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/plan_status"
            android:accessibilityLiveRegion="polite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/plan_loading"
        android:textColor="@color/asterion_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/plan_retry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_retry_read"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/plan_entries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="9dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/plan_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/plan_create"
        android:textStyle="bold" />

    <Button
        android:id="@+id/plan_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/plan_back"
        android:textStyle="bold" />
</LinearLayout>
