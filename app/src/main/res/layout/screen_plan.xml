<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asterion_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/plan_title"
        android:textColor="@color/asterion_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/plan_subtitle"
        android:textColor="@color/asterion_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/plan_previous_week"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/plan_previous_week"
            android:text="‹" />

        <TextView
            android:id="@+id/plan_week_title"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/asterion_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/plan_next_week"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/plan_next_week"
            android:text="›" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/plan_day_0" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" />
        <Button android:id="@+id/plan_day_1" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" />
        <Button android:id="@+id/plan_day_2" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" />
        <Button android:id="@+id/plan_day_3" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" />
        <Button android:id="@+id/plan_day_4" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" />
        <Button android:id="@+id/plan_day_5" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" />
        <Button android:id="@+id/plan_day_6" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/plan_selected_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/asterion_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/plan_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/plan_loading"
        android:textColor="@color/asterion_text_secondary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/plan_retry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_retry_read" />

    <ListView
        android:id="@+id/plan_entries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/plan_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/plan_create" />

    <Button
        android:id="@+id/plan_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/plan_back" />
</LinearLayout>
