<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routine_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:background="#FFFFFF">
    <TextView
        android:id="@+id/routine_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ASTERION · RUTINA PASO A PASO"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#111111"/>
    <TextView
        android:id="@+id/routine_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Cargando ejercicios..."
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="#333333"/>
    <View
        android:id="@+id/routine_category_color"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:background="#2088B7"/>
    <ScrollView android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/routine_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"/>
    </ScrollView>
    <Button
        android:id="@+id/routine_rest"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:text="Descanso opcional"
        android:textAllCaps="false"
        android:textStyle="bold"/>
    <Button
        android:id="@+id/routine_next"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="Registrar y continuar"
        android:textAllCaps="false"
        android:textStyle="bold"/>
    <Button
        android:id="@+id/routine_pause"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="Pausar o finalizar sin indicar motivo"
        android:textAllCaps="false"
        android:textStyle="bold"/>
    <Button
        android:id="@+id/routine_stop"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="Detener sesión por lesión o malestar"
        android:textAllCaps="false"
        android:textStyle="bold"/>
</LinearLayout>