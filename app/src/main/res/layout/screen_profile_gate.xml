<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060C1F">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/asterion_profile_background"
        android:contentDescription="@null" />
    <View android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#77040A20" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">
            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/asterion_profile_seal"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:fontFamily="serif"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="#F5F7FF"
                android:textSize="25sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/profile_gate_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.30"
                    android:text="@string/profile_system_label"
                    android:textColor="#84D1FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:fontFamily="serif"
                    android:text="@string/profile_gate_title"
                    android:textColor="#F6F6FF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/profile_gate_description"
                    android:textColor="#CDD9F7"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <View android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#457BCFFF" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:id="@+id/profile_gate_create"
                        android:layout_width="0dp"
                        android:layout_height="207dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:padding="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:focusable="true"
                        android:clickable="true"
                        android:importantForAccessibility="yes"
                        android:contentDescription="@string/profile_create_action">
                        <ImageView android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:src="@drawable/asterion_profile_create"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:fontFamily="serif"
                            android:text="@string/profile_create_action"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/profile_create_description"
                            android:textColor="#D9D3F1"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/profile_gate_restore"
                        android:layout_width="0dp"
                        android:layout_height="207dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:padding="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:focusable="true"
                        android:clickable="true"
                        android:importantForAccessibility="yes"
                        android:contentDescription="@string/profile_restore_action">
                        <ImageView android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:src="@drawable/asterion_profile_restore"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:fontFamily="serif"
                            android:text="@string/profile_restore_action"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/profile_restore_description"
                            android:textColor="#D2E7FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:text="@string/profile_gate_footer"
                    android:textColor="#AAC8FA"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
