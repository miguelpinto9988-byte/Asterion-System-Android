<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/asterion_night_backdrop"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/asterion_crest" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/plan_form_title"
            android:textColor="@color/asterion_text"
            android:textSize="24sp"
            android:letterSpacing="0.04"
            android:textStyle="bold"
        android:fontFamily="serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/plan_form_subtitle"
            android:textColor="@color/asterion_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/plan_activity_label"
            android:textColor="@color/asterion_text" />

        <Spinner
            android:id="@+id/plan_activity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/plan_activity_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/plan_date"
            android:text="@string/plan_date_label"
            android:textColor="@color/asterion_text" />

        <EditText
            android:id="@+id/plan_date"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/plan_date_format_hint"
            android:inputType="date"
            android:maxLength="10"
            android:singleLine="true"
            android:textColor="@color/asterion_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/plan_time"
            android:text="@string/plan_time_label"
            android:textColor="@color/asterion_text" />

        <EditText
            android:id="@+id/plan_time"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/plan_time_format_hint"
            android:inputType="time"
            android:maxLength="5"
            android:singleLine="true"
            android:textColor="@color/asterion_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/plan_duration"
            android:text="@string/plan_duration_label"
            android:textColor="@color/asterion_text" />

        <EditText
            android:id="@+id/plan_duration"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/plan_duration_format_hint"
            android:inputType="number"
            android:maxLength="3"
            android:singleLine="true"
            android:textColor="@color/asterion_text" />

        <TextView
            android:id="@+id/plan_form_status"
            android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/plan_loading"
            android:textColor="@color/asterion_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/plan_form_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offline_retry_read" />

        <Button
            android:id="@+id/plan_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/plan_save" />

        <Button
            android:id="@+id/plan_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plan_delete" />

        <Button
            android:id="@+id/plan_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plan_cancel" />
    </LinearLayout>
</ScrollView>
