<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/asterion_night_backdrop"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/asterion_crest" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/settings_title"
            android:textColor="@color/asterion_text"
            android:textSize="24sp"
            android:letterSpacing="0.04"
            android:textStyle="bold"
        android:fontFamily="serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/settings_description"
            android:textColor="@color/asterion_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings_text_heading"
            android:textColor="@color/asterion_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/settings_text_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/asterion_list_card"
            android:padding="12dp"
            android:layout_marginTop="8dp">
            <RadioButton
                android:id="@+id/settings_text_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_text_normal"
                android:textColor="@color/asterion_text"
                android:textStyle="bold" />
            <RadioButton
                android:id="@+id/settings_text_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_text_large"
                android:textColor="@color/asterion_text"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/settings_density_heading"
            android:textColor="@color/asterion_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/settings_density_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/asterion_list_card"
            android:padding="12dp"
            android:layout_marginTop="8dp">
            <RadioButton
                android:id="@+id/settings_density_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_density_normal"
                android:textColor="@color/asterion_text"
                android:textStyle="bold" />
            <RadioButton
                android:id="@+id/settings_density_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_density_compact"
                android:textColor="@color/asterion_text"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/settings_start_heading"
            android:textColor="@color/asterion_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/settings_start_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/asterion_list_card"
            android:padding="12dp"
            android:layout_marginTop="8dp">
            <RadioButton
                android:id="@+id/settings_start_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_start_home"
                android:textColor="@color/asterion_text"
                android:textStyle="bold" />
            <RadioButton
                android:id="@+id/settings_start_catalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_start_catalog"
                android:textColor="@color/asterion_text"
                android:textStyle="bold" />
            <RadioButton
                android:id="@+id/settings_start_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_start_plan"
                android:textColor="@color/asterion_text"
                android:textStyle="bold" />
            <RadioButton
                android:id="@+id/settings_start_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_start_progress"
                android:textColor="@color/asterion_text"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_start_explanation"
            android:textColor="@color/asterion_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_reset"
            android:textStyle="bold" />
        <Button
            android:id="@+id/settings_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_back"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/settings_privacy_note"
            android:textColor="@color/asterion_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
