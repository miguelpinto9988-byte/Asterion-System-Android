<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/asterion_night_backdrop"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/asterion_crest" />

        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/catalog_title"
        android:textColor="@color/asterion_text"
        android:textSize="24sp"
            android:letterSpacing="0.04"
        android:textStyle="bold"
        android:fontFamily="serif" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/catalog_demo_note"
        android:textColor="@color/asterion_text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/catalog_search"
        android:contentDescription="@string/catalog_search_hint"
        android:minHeight="48dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/catalog_search_hint"
        android:inputType="text"
        android:maxLength="120"
        android:singleLine="true"
        android:textColor="@color/asterion_text" />

    <Spinner
        android:id="@+id/catalog_category_filter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/catalog_category_filter_label" />

    <Spinner
        android:id="@+id/catalog_type_filter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/catalog_type_filter_label" />

    <TextView
        android:id="@+id/catalog_status"
            android:accessibilityLiveRegion="polite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/catalog_loading"
        android:textColor="@color/asterion_text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/catalog_retry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_retry_read" />

    <ListView
        android:id="@+id/catalog_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="none"
        android:divider="@android:color/transparent"
        android:dividerHeight="9dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/catalog_back_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/catalog_back_to_home" />
</LinearLayout>
