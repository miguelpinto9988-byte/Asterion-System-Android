<?xml version="1.0" encoding="utf-8"?>
<!-- Exactly five vertically stacked rectangular cards, avatar at upper-right.
     Three stable destinations in a separate native bottom bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/home_root"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ASTERION SYSTEM"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CENTRO DEL CAZADOR"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:textStyle="bold"
                        android:textColor="#555555"/>
                </LinearLayout>
                <ImageButton
                    android:id="@+id/home_avatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="12dp"
                    android:padding="3dp"
                    android:src="@drawable/asterion_reg_profile"
                    android:scaleType="centerCrop"
                    android:background="@drawable/asterion_avatar_frame"
                    android:clipToOutline="true"
                    android:contentDescription="Abrir perfil y modificar mis datos"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_card_monarch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- El arte es un recurso offline; la niebla se aplica por separado. -->
                <FrameLayout
                    android:id="@+id/monarch_hero"
                    android:layout_width="match_parent"
                    android:layout_height="218dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <ImageView
                        android:id="@+id/monarch_feature_image"
                        android:layout_width="match_parent"
                        android:layout_height="252dp"
                        android:translationY="-30dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/monarch_igris_capture"
                        android:contentDescription="Ilustración de Igris, comandante carmesí" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/asterion_monarch_scrim"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="15dp">
                        <TextView
                            android:id="@+id/monarch_eye"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JEFE DE LA SEMANA · ARTE DE IGRIS"
                            android:textSize="11sp"
                            android:letterSpacing="0.08"
                            android:textStyle="bold"
                            android:textColor="#59D8FF" />
                        <TextView
                            android:id="@+id/monarch_hero_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="MISIÓN MONARCA"
                            android:textSize="23sp"
                            android:letterSpacing="0.035"
                            android:textStyle="bold"
                            android:textColor="#F2FAFF" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="18dp">
                    <TextView
                        android:id="@+id/monarch_art_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="IGRIS · COMANDANTE CARMESÍ"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#62D8FF" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Desafío opcional de cinco días. Previsualiza sus cinco ejercicios antes de decidir."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#E5EEFF" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="GALERÍA DE JEFES · ARTE ILUSTRATIVO"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.07"
                        android:textColor="#62D8FF" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageButton
                            android:id="@+id/monarch_portrait_igris"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="73dp"
                            android:layout_marginEnd="5dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/monarch_igris_capture"
                            android:background="@drawable/asterion_monarch_thumb"
                            android:contentDescription="Mostrar arte original de Igris" />
                        <ImageButton
                            android:id="@+id/monarch_portrait_beru"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="73dp"
                            android:layout_marginEnd="5dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/asterion_shadow_sentinel"
                            android:background="@drawable/asterion_monarch_thumb"
                            android:contentDescription="Mostrar arte original de Beru si está incluido" />
                        <ImageButton
                            android:id="@+id/monarch_portrait_ashborn"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="73dp"
                            android:layout_marginEnd="5dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/asterion_shadow_sentinel"
                            android:background="@drawable/asterion_monarch_thumb"
                            android:contentDescription="Mostrar arte original de Ashborn si está incluido" />
                        <ImageButton
                            android:id="@+id/monarch_portrait_baran"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="73dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/asterion_shadow_sentinel"
                            android:background="@drawable/asterion_monarch_thumb"
                            android:contentDescription="Mostrar arte original de Baran si está incluido" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="IGRIS"
                            android:textStyle="bold" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="BERU"
                            android:textStyle="bold" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="ASHBORN"
                            android:textStyle="bold" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="BARAN"
                            android:textStyle="bold" android:gravity="center" android:textSize="10sp"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/open_monarch"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:minHeight="48dp"
                        android:layout_marginTop="14dp"
                        android:text="ABRIR MISIÓN MONARCA"
                        android:textAllCaps="false"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_card_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="02 · TARJETA DE PERFIL"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>
                <TextView
                    android:id="@+id/home_profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cazador"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>
                <TextView
                    android:id="@+id/home_profile_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Configuración personal guardada. Para editarla, toca tu avatar arriba."
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_card_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="03 · MISIONES DIARIAS"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Opciones del catálogo según tu planificación semanal y el equipo disponible."
                    android:textSize="13sp"
                    android:layout_marginTop="7dp"
                    android:textColor="#555555"
                    android:textStyle="bold"/>
                <Button
                    android:id="@+id/open_daily"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:minHeight="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Ver propuestas de hoy"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_card_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="04 · PROGRESO Y EVOLUCIÓN"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Historial y seguimiento personal de los registros realizados."
                    android:textSize="13sp"
                    android:layout_marginTop="7dp"
                    android:textColor="#555555"
                    android:textStyle="bold"/>
                <Button
                    android:id="@+id/open_progress"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:minHeight="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Ver mi progreso"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_card_library"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="05 · BIBLIOTECA DE EJERCICIOS"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="125 familias, 354 tipos y 1.017 variantes locales."
                    android:textSize="13sp"
                    android:layout_marginTop="7dp"
                    android:textColor="#555555"
                    android:textStyle="bold"/>
                <Button
                    android:id="@+id/open_library"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:minHeight="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Explorar biblioteca"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:src="@drawable/asterion_guardian"
                android:contentDescription="@string/design_guardian_description"
                android:visibility="gone"/>
            <ImageView
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:src="@drawable/asterion_shadow_sentinel"
                android:importantForAccessibility="no"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/home_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#FFFFFF"/>
</LinearLayout>
