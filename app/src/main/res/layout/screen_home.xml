<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/asterion_night_backdrop"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/asterion_crest"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.04"
                    android:text="@string/app_name"
                    android:textColor="@color/asterion_text"
                    android:textSize="27sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/design_header_tagline"
                    android:textColor="@color/asterion_accent"
                    android:textSize="11sp"
                    android:letterSpacing="0.09" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/asterion_hero_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:minHeight="184dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="0dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/design_hero_title"
                    android:textColor="@color/asterion_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/design_hero_description"
                    android:textColor="@color/asterion_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/asterion_arcane_panel"
                    android:padding="9dp"
                    android:text="@string/design_offline_state"
                    android:textColor="@color/asterion_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <ImageView
                android:layout_width="120dp"
                android:layout_height="164dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/design_guardian_description"
                android:src="@drawable/asterion_guardian" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="serif"
            android:text="@string/design_section_actions"
            android:textColor="@color/asterion_text"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/design_actions_caption"
            android:textColor="@color/asterion_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/open_catalog"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/asterion_card_selector"
                android:contentDescription="@string/catalog_open_button"
                android:drawableTop="@drawable/asterion_ic_catalog"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/design_nav_catalog"
                android:textColor="@color/asterion_text"
                android:textSize="15sp" />
            <Button
                android:id="@+id/open_plan"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/asterion_card_selector"
                android:contentDescription="@string/plan_open"
                android:drawableTop="@drawable/asterion_ic_plan"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/design_nav_plan"
                android:textColor="@color/asterion_text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/open_progress"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/asterion_card_selector"
                android:contentDescription="@string/progress_open"
                android:drawableTop="@drawable/asterion_ic_progress"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/design_nav_progress"
                android:textColor="@color/asterion_text"
                android:textSize="15sp" />
            <Button
                android:id="@+id/open_settings"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/asterion_card_selector"
                android:contentDescription="@string/settings_open"
                android:drawableTop="@drawable/asterion_ic_settings"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/design_nav_settings"
                android:textColor="@color/asterion_text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/asterion_list_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="72dp"
                android:src="@drawable/asterion_shadow_sentinel"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/design_local_title"
                    android:textColor="@color/asterion_text"
                    android:textStyle="bold"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/design_local_description"
                    android:textColor="@color/asterion_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <Button
                android:id="@+id/open_local_status"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/asterion_card_selector"
                android:contentDescription="@string/local_status_open"
                android:drawableTop="@drawable/asterion_ic_status"
                android:gravity="center"
                android:text="" />
        </LinearLayout>

        <Button
            android:id="@+id/open_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/asterion_card_selector"
            android:text="@string/navigation_open_secondary"
            android:textColor="@color/asterion_text_secondary" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/design_footer_note"
            android:textColor="@color/asterion_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
