<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/home_shell" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/asterionPage">
    <ScrollView android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/home_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ASTERION" android:textSize="24sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="S Y S T E M" android:textSize="10sp" android:textStyle="bold" android:tag="overline"/>
                </LinearLayout>
                <ImageButton android:id="@+id/home_avatar" android:layout_width="52dp" android:layout_height="52dp" android:minWidth="48dp" android:minHeight="48dp" android:padding="12dp" android:src="@drawable/ic_as_profile" android:tag="avatar" android:scaleType="centerCrop" android:clipToOutline="true" android:contentDescription="Abrir perfil y modificar mis datos"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu centro de mando" android:textSize="26sp" android:textStyle="bold" android:layout_marginTop="18dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Un día más. Un paso más." android:textSize="13sp" android:textStyle="bold" android:tag="muted" android:layout_marginTop="4dp"/>
            <LinearLayout android:id="@+id/home_card_monarch" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:tag="hero">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01 / MISIÓN MONARCA" android:textSize="11sp" android:textStyle="bold" android:tag="overline"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Despierta tu poder" android:textSize="23sp" android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4 jefes · 5 días" android:textSize="13sp" android:textStyle="bold" android:tag="muted" android:layout_marginTop="6dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OPCIONAL" android:textSize="10sp" android:textStyle="bold" android:tag="overline" android:layout_marginTop="12dp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="104dp" android:layout_height="104dp" android:src="@drawable/asterion_monarch_emblem" android:importantForAccessibility="no" android:tag="art"/>
                </LinearLayout>
                <Button android:id="@+id/open_monarch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:text="Ver misión Monarca" android:drawableEnd="@drawable/ic_as_arrow" android:drawablePadding="8dp" android:textStyle="bold" android:textSize="14sp" android:textAllCaps="false" android:tag="primary"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/home_card_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:tag="card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="02 / TU PERFIL" android:textSize="11sp" android:textStyle="bold" android:tag="overline"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cazador" android:textSize="21sp" android:textStyle="bold" android:id="@+id/home_profile_name" android:layout_marginTop="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu configuración de entrenamiento" android:textSize="13sp" android:textStyle="bold" android:tag="muted" android:id="@+id/home_profile_summary" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/home_card_daily" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:tag="card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="03 / MISIONES DIARIAS" android:textSize="11sp" android:textStyle="bold" android:tag="overline"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu plan, adaptado a ti" android:textSize="16sp" android:textStyle="bold" android:id="@+id/home_daily_summary" android:layout_marginTop="8dp"/>
                <LinearLayout android:id="@+id/home_daily_entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                <Button android:id="@+id/open_daily" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:text="Ver misiones de hoy" android:drawableEnd="@drawable/ic_as_arrow" android:drawablePadding="8dp" android:textStyle="bold" android:textSize="14sp" android:textAllCaps="false" android:tag="secondary"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/home_card_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:tag="card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="04 / PROGRESO Y EVOLUCIÓN" android:textSize="11sp" android:textStyle="bold" android:tag="overline"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu constancia cuenta" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu semana en movimiento" android:textSize="12sp" android:textStyle="bold" android:tag="muted" android:id="@+id/home_progress_summary"/>
                <pe.asterionsystem.app.WeekProgressView android:id="@+id/home_week_progress" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp"/>
                <Button android:id="@+id/open_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:text="Ver progreso" android:drawableEnd="@drawable/ic_as_arrow" android:drawablePadding="8dp" android:textStyle="bold" android:textSize="14sp" android:textAllCaps="false" android:tag="secondary"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/home_card_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:tag="card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="05 / BIBLIOTECA DE EJERCICIOS" android:textSize="11sp" android:textStyle="bold" android:tag="overline"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Encuentra tu ejercicio" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fuerza · Movilidad · Cardio" android:textSize="12sp" android:textStyle="bold" android:tag="muted" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/open_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:text="Explorar biblioteca" android:drawableEnd="@drawable/ic_as_arrow" android:drawablePadding="8dp" android:textStyle="bold" android:textSize="14sp" android:textAllCaps="false" android:tag="secondary"/>
            </LinearLayout>
            <ImageView android:layout_width="1dp" android:layout_height="1dp" android:src="@drawable/asterion_guardian" android:contentDescription="@string/design_guardian_description" android:visibility="gone"/>
            <ImageView android:layout_width="1dp" android:layout_height="1dp" android:src="@drawable/asterion_shadow_sentinel" android:importantForAccessibility="no" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:id="@+id/home_bottom_bar" android:layout_width="match_parent" android:layout_height="72dp"/>
</LinearLayout>
