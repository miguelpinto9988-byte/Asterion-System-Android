<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AsterionSystem" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/asterion_accent</item>
        <item name="android:windowBackground">@color/asterion_background</item>
        <item name="android:statusBarColor">@color/asterion_background</item>
        <item name="android:navigationBarColor">@color/asterion_background</item>
        <item name="android:colorControlNormal">@color/asterion_text_secondary</item>
        <item name="android:colorControlActivated">@color/asterion_accent</item>
        <item name="android:textColorPrimary">@color/asterion_text</item>
        <item name="android:textColorSecondary">@color/asterion_text_secondary</item>
        <item name="android:buttonStyle">@style/Asterion.ActionButton</item>
        <item name="android:editTextStyle">@style/Asterion.TextInput</item>
    </style>
    <style name="Theme.AsterionSplash" parent="Theme.AsterionSystem">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/asterion_background</item>
    </style>
    <style name="Asterion.ActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/asterion_button_selector</item>
        <item name="android:textColor">@color/asterion_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <style name="Asterion.TextInput" parent="android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/asterion_text</item>
        <item name="android:textColorHint">@color/asterion_text_secondary</item>
        <item name="android:backgroundTint">@color/asterion_accent</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
